From: Paul Thomson <paulthomson@google.com>
Date: Fri, 17 Apr 2026 13:20:50 +0100
Subject: [PATCH 05/11] AA: expose getJvmNameFromAnnotation for Lint

---
 .../light/classes/symbol/annotations/symbolAnnotationsUtils.kt | 3 ++-
 1 file changed, 2 insertions(+), 1 deletion(-)

diff --git a/analysis/symbol-light-classes/src/org/jetbrains/kotlin/light/classes/symbol/annotations/symbolAnnotationsUtils.kt b/analysis/symbol-light-classes/src/org/jetbrains/kotlin/light/classes/symbol/annotations/symbolAnnotationsUtils.kt
index c5387906acd..b6d132bb3da 100644
--- a/analysis/symbol-light-classes/src/org/jetbrains/kotlin/light/classes/symbol/annotations/symbolAnnotationsUtils.kt
+++ b/analysis/symbol-light-classes/src/org/jetbrains/kotlin/light/classes/symbol/annotations/symbolAnnotationsUtils.kt
@@ -36,7 +36,8 @@ internal fun KaAnnotatedSymbol.hasJvmSyntheticAnnotation(): Boolean {
     return JVM_SYNTHETIC_ANNOTATION_CLASS_ID in annotations
 }
 
-internal fun KaAnnotatedSymbol.getJvmNameFromAnnotation(): String? {
+// Expose to use at KotlinStaticPsiDeclarationFromBinaryModuleProvider
+fun KaAnnotatedSymbol.getJvmNameFromAnnotation(): String? {
     return stringArgumentFromAnnotation(JvmStandardClassIds.Annotations.JvmName)
 }
 
