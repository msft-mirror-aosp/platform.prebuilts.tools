  <modelVersion>4.0.0</modelVersion>
  <groupId>com.android.tools.apkdeployer</groupId>
  <artifactId>apkdeployer</artifactId>
  <version>8.8.0-alpha05</version>
  <name>com.android.tools.apkdeployer.apkdeployer</name>
  <description>Library used to deploy Android applications</description>
