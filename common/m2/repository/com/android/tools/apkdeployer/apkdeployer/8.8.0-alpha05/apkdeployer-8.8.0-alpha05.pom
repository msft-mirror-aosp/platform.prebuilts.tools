      <name>The Apache Software License, Version 2.0</name>
      <url>http://www.apache.org/licenses/LICENSE-2.0.txt</url>
      <distribution>repo</distribution>
    </license>
  </licenses>
  <developers>
    <developer>
      <name>The Android Open Source Project</name>
    </developer>
  </developers>
  <dependencies>
    <dependency>
      <groupId>com.android.tools.adblib</groupId>
      <artifactId>adblib</artifactId>
      <version>8.8.0-alpha05</version>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>com.android.tools.adblib</groupId>
      <artifactId>adblib-tools</artifactId>
      <version>8.8.0-alpha05</version>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>com.android.tools</groupId>
      <artifactId>annotations</artifactId>
      <version>31.8.0-alpha05</version>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>com.android.tools.apkparser</groupId>
      <artifactId>binary-resources</artifactId>
      <version>31.8.0-alpha05</version>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>com.android.tools</groupId>
      <artifactId>common</artifactId>
      <version>31.8.0-alpha05</version>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>com.android.tools.ddms</groupId>
      <artifactId>ddmlib</artifactId>
      <version>31.8.0-alpha05</version>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>com.android</groupId>
      <artifactId>zipflinger</artifactId>
      <version>8.8.0-alpha05</version>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>com.android.tools</groupId>
      <artifactId>r8</artifactId>
      <version>8.2.47</version>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>com.google.guava</groupId>
      <artifactId>guava</artifactId>
      <version>32.0.1-jre</version>
