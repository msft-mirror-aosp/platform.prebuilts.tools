  <modelVersion>4.0.0</modelVersion>
  <groupId>io.modelcontextprotocol</groupId>
  <artifactId>kotlin-sdk</artifactId>
  <version>0.5.0</version>
  <name>kotlin-sdk</name>
  <description>Kotlin implementation of the Model Context Protocol (MCP)</description>
  <url>https://github.com/modelcontextprotocol/kotlin-sdk</url>
  <licenses>
    <license>
      <name>MIT License</name>
      <url>https://github.com/modelcontextprotocol/kotlin-sdk/blob/main/LICENSE</url>
      <distribution>repo</distribution>
    </license>
  </licenses>
  <developers>
    <developer>
      <id>Anthropic</id>
      <name>Anthropic Team</name>
      <organization>Anthropic</organization>
      <organizationUrl>https://www.anthropic.com</organizationUrl>
    </developer>
  </developers>
  <scm>
    <connection>scm:git:git://github.com/modelcontextprotocol/kotlin-sdk.git</connection>
    <developerConnection>scm:git:git@github.com:modelcontextprotocol/kotlin-sdk.git</developerConnection>
    <url>https://github.com/modelcontextprotocol/kotlin-sdk</url>
  </scm>
  <dependencies>
    <dependency>
      <groupId>org.jetbrains.kotlinx</groupId>
      <artifactId>kotlinx-serialization-json</artifactId>
      <version>1.7.3</version>
